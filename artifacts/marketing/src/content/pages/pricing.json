  "faq": [
    {
      "id": "faq-1",
      "question": "Is there a free trial?",
      "answer": "Yes — every plan starts with a 60-day free trial. You can upgrade, downgrade, or cancel at any time."
    },
    {
      "id": "faq-2",
      "question": "Can I change plans later?",
      "answer": "Absolutely. You can upgrade or downgrade your plan at any time from your account settings. Changes take effect immediately."
    },
    {
      "id": "faq-3",
      "question": "Are there any setup fees?",
      "answer": "None. There are no setup fees, no hidden charges, and no long-term contracts. You only pay the monthly subscription."
    },
    {
      "id": "faq-4",
      "question": "What payment methods do you accept?",
      "answer": "We accept all major credit and debit cards. Enterprise customers can also pay by invoice."
    },
    {
      "id": "faq-5",
      "question": "Do you offer discounts for annual billing?",
      "answer": "Yes — pay annually and save 20% compared to monthly billing. Contact us to switch to an annual plan."
    },
    {
      "id": "faq-6",
      "question": "What types of businesses does Certxa support?",
      "answer": "Certxa is built for nail salons, hair salons, barbershops, spas, massage studios, hair removal studios, and braid and weave salons. The booking flow, kiosk, and POS all adapt to the services your business offers."
    }
  ],
