  "faq": [
    {
      "id": "faq-1",
      "question": "How much does Certxa cost?",
      "answer": "The Solo plan, for one independent professional, is free with no credit card needed. Professional is $22 a month and Elite is $49 a month, or $18 and $39 a month when billed annually."
    },
    {
      "id": "faq-2",
      "question": "Is there a free trial?",
      "answer": "Yes. Professional and Elite start with a 60-day free trial. A credit card is required to start a paid plan, but you are not charged until the trial ends. Solo is free and needs no trial."
    },
    {
      "id": "faq-3",
      "question": "Can I change plans later?",
      "answer": "Yes. You can upgrade, downgrade, or cancel at any time. There are no long-term contracts."
    },
    {
      "id": "faq-4",
      "question": "What does card processing cost?",
      "answer": "Payments run through Stripe. In-person card payments are 2.7% + $0.05 and online payments are 2.9% + $0.30, which is Stripe's rate, plus a $0.60 Certxa fee per card transaction."
    },
    {
      "id": "faq-5",
      "question": "Is the Autumn AI receptionist included?",
      "answer": "Yes. Every plan includes Autumn: 20 calls a month on Solo, 50 on Professional and 100 on Elite. Additional calls are $0.50 each. There is a one-time $15 activation fee for your dedicated phone number. Free trials don't include calls; a trial's calls are $0.50 each."
    },
    {
      "id": "faq-6",
      "question": "What types of businesses does Certxa support?",
      "answer": "Certxa is built for nail salons, hair salons, barbershops, spas, massage studios, hair removal studios, and braid and weave salons."
    }
  ],
  "cta": {
    "headline": "Start free on Solo.",
    "subhead": "Or try Professional or Elite free for 60 days. Cancel anytime.",
    "button": "Get started free"
  }
