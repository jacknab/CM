# ─────────────────────────────────────────────────────────────────────────────
# Certxa — environment variables
# Copy this file to .env and fill in the values for your environment.
# On Replit, set these as Secrets (never commit real values to source control).
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required).
DATABASE_URL=postgresql://user:password@host:5432/certxa


# ── Session ───────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string


# ── Application URLs ──────────────────────────────────────────────────────────
# Public base URL of the API server (no trailing slash).
# Used to construct absolute callback URLs and Twilio webhook URLs.
APP_URL=https://yourdomain.com

# Explicit API base URL for the Staff Mobile app (overrides APP_URL).
# Use this when APP_URL is a private/internal address and the mobile app
# needs to reach the API via the public domain name instead.
# Example: MOBILE_API_URL=https://certxa.com
MOBILE_API_URL=

# Public URL of the frontend SPA (defaults to APP_URL when not set).
FRONTEND_URL=https://app.yourdomain.com

# Cookie domain for cross-subdomain sessions (e.g. .yourdomain.com).
# Leave blank on Replit — it sets the domain automatically.
COOKIE_DOMAIN=

# Runtime environment: development | production
NODE_ENV=production

# Port the API server listens on (default: 5000).
PORT=5000


# ── OpenAI — AI Receptionist ──────────────────────────────────────────────────
# Required for the AI voice receptionist feature.
# On Replit the integration sets AI_INTEGRATIONS_OPENAI_API_KEY automatically;
# set OPENAI_API_KEY on your VPS.
OPENAI_API_KEY=sk-proj-...
# Low-cost model used by the salon-owner Growth Analyst chat.
MEMBERS_ASSISTANT_MODEL=gpt-4o-mini
# Ambient mix level for AI receptionist audio (0 = off, 1 = full source level).
AI_RECEPTIONIST_AMBIENCE_VOLUME=0.16

# Credit charged per completed AI Receptionist call (in USD).
# Calls ≤ 30 seconds are never charged. Default: $0.50 per call.
# Set to 0 to disable per-call credit deductions.
AI_CALL_RATE_USD=0.50

# Set automatically by the Replit OpenAI integration — do not set manually on Replit.
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=


# ── OpenRouter — Fallback for AI services ────────────────────────────────────────
# Optional. Used as fallback when OpenAI quota/credits are exhausted.
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: Custom referer for OpenRouter analytics (defaults to your APP_URL)
OPENROUTER_REFERER=


# ── Twilio ────────────────────────────────────────────────────────────────────
# Required for SMS reminders, the AI voice receptionist, and outbound dialing.
# Find all three values in the Twilio Console → Account → API keys & tokens.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Direct from-number — use this for simple single-number setups.
TWILIO_PHONE_NUMBER=+15551234567
# Messaging Service SID — preferred for A2P 10DLC / toll-free pools (MG...).
# If set, this takes priority over TWILIO_PHONE_NUMBER for all outbound sends.
# At least one of TWILIO_PHONE_NUMBER or TWILIO_MESSAGING_SERVICE_SID is required.
TWILIO_MESSAGING_SERVICE_SID=

# Public base URL used to construct Twilio webhook URLs on your VPS.
# On Replit this is derived from REPLIT_DEV_DOMAIN automatically.
# On your VPS set this to: https://voice.certxa.com
PUBLIC_BASE_URL=https://voice.certxa.com


# ── Mailgun — transactional email ────────────────────────────────────────────
# Required for appointment confirmation/reminder emails.
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mail.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=Certxa


# ── Google OAuth — staff / owner login ───────────────────────────────────────
# Optional. Enables "Sign in with Google" for staff and owners.
#
# SETUP STEPS:
#   1. Go to console.cloud.google.com → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (Web application)
#   3. Add the redirect URI below to "Authorised redirect URIs"
#   4. Copy the Client ID and Client Secret here
#
# Redirect URI to add in Google Console:
#   https://api.yourdomain.com/api/auth/google/callback
#
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Full callback URL (must match exactly what is registered in Google Console).
GOOGLE_LOGIN_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback


# ── Google Business Profile — Connect button & reviews sync ──────────────────
# Required for the "Connect Google Business Profile" button and automatic
# Google review syncing.
#
# SETUP STEPS (can reuse the same GCP project as Google Login above):
#   1. Go to console.cloud.google.com → APIs & Services → Library
#      Enable ALL THREE of these APIs:
#        • My Business Account Management API
#        • My Business Business Information API
#        • My Business Reviews API  (mybusinessreviews.googleapis.com)
#
#   2. Go to APIs & Services → OAuth consent screen
#      • Add the scope:  https://www.googleapis.com/auth/business.manage
#      • If the app is in "Testing" mode, add your Google account as a test user.
#        For production, submit for Google verification.
#
#   3. Go to APIs & Services → Credentials → your OAuth 2.0 Client ID
#      Add the redirect URI below to "Authorised redirect URIs":
#        https://api.yourdomain.com/api/google-business/callback
#
#   4. Copy the Client ID and Client Secret here.
#      You can use the same OAuth client as Google Login, or create a separate one.
#
# NOTE: This is SEPARATE from GOOGLE_LOGIN_* above.
#       Login tokens (openid/email) must never be shared with the Business API.
#
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# Full callback URL (must match exactly what is registered in Google Console).
# The server falls back to https://certxa.com/api/google-business/callback if unset.
GOOGLE_BUSINESS_CALLBACK_URL=https://api.yourdomain.com/api/google-business/callback


# ── Stripe — platform billing ────────────────────────────────────────────────
# Required if you charge salons a SaaS subscription fee.
# Use test keys in development, live keys in production.
STRIPE_SECRET_KEY=sk_live_...
# STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# Optional: comma-separated list for accepting multiple webhook signing secrets
# (useful during Stripe endpoint secret rotation or when validating both test + live).
# STRIPE_WEBHOOK_SECRETS=whsec_live...,whsec_test...

# Optional one-time setup/device fee charged at subscription start.
ENABLE_SETUP_FEE=false
STRIPE_SETUP_FEE_PRICE_ID=
STRIPE_SETUP_FEE_AMOUNT=100
STRIPE_SETUP_FEE_LABEL=Device Setup Fee

# Stripe trial period in days (overridden by admin UI setting).
TRIAL_PERIOD_DAYS=14


# ── Cloudflare R2 — image & file storage ─────────────────────────────────────
# Required for staff avatar uploads and any media uploads.
# Without these the avatar endpoint returns 500. Set all four vars.
#
# Where to find these in the Cloudflare dashboard:
#   1. R2_ENDPOINT  — R2 → Overview → "S3 API" row, looks like:
#                     https://<account-id>.r2.cloudflarestorage.com
#   2. R2_BUCKET_NAME — the name of the bucket you created (e.g. certxa-media)
#   3. R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY — R2 → Overview → Manage R2 API tokens
#                     → Create API token → "Object Read & Write" on your bucket
#   4. R2_PUBLIC_URL — only needed if the bucket has a custom public domain or
#                     Cloudflare R2 public access enabled. If left blank the server
#                     constructs it as <R2_ENDPOINT>/<R2_BUCKET_NAME> (works for
#                     private buckets accessed via pre-signed URLs).
#                     Example with custom domain: https://media.yourdomain.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=certxa-media
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_PUBLIC_URL=https://media.yourdomain.com


# ── Internal API keys ────────────────────────────────────────────────────────
# Simple bearer-token protection for internal endpoints.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DIALER_API_KEY=
CHATBOT_API_KEY=
