# Your Stripe PLATFORM secret key (starts with sk_live_ / sk_test_).
# Never commit the real value — this file is just a template.
STRIPE_SECRET_KEY=sk_test_...

PORT=4242

# Must match the main certxa.com app EXACTLY — this backend verifies
# the same certxa.sid session cookie, so it needs the same signing
# secret and the same Postgres "sessions" table to read from.
SESSION_SECRET=same-value-as-main-app
DATABASE_URL=postgres://user:password@host:5432/certxa

# Comma-separated list of origins allowed to call this API.
# The mobile app itself doesn't need CORS (it's not a browser), this is
# for if certxa.com ever calls the backend directly too.
ALLOWED_ORIGINS=https://certxa.com
