{
  "expo": {
    "name": "Certxa Staff Portal",
    "slug": "certxa-staff",
    "version": "1.0.0",
    "orientation": "default",
    "sdkVersion": "54.0.0",
    "userInterfaceStyle": "dark",
    "scheme": "certxa-staff",
    "icon": "./assets/icon.png",
    "platforms": [
      "android"
    ],
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#050C18"
    },
    "android": {
      "package": "com.certxa.staff",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050C18"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Certxa Staff Portal to access your camera to scan QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050C18",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "4e5b3216-8478-4e39-ac19-fbfb630619a8"
      },
      "router": {}
    },
    "owner": "certxas-team"
  }
}
