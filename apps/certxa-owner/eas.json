{
  "cli": {
    "version": ">= 14.0.0",
    "requireCommit": false,
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "pnpm": "10.26.1",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_PORTAL_URL": "https://certxa.com/app-login"
      },
      "channel": "preview"
    },
    "staging": {
      "distribution": "internal",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PORTAL_URL": "https://staging.certxa.com"
      },
      "channel": "staging"
    },
    "production": {
      "distribution": "store",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_PORTAL_URL": "https://certxa.com/app-login"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6815638402",
        "ascApiKeyPath": "/etc/certxa-eas-AuthKey.p8",
        "ascApiKeyId": "4AUA345PA2",
        "ascApiKeyIssuerId": "a13ba69b-2999-4910-ab6a-7a19dcf97f19"
      }
    }
  }
}
