{
  "expo": {
    "name": "Certxa",
    "slug": "ucertxa",
    "version": "1.0.3",
    "orientation": "default",
    "sdkVersion": "54.0.0",
    "userInterfaceStyle": "dark",
    "scheme": "certxa-owner",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios"
    ],
    "newArchEnabled": false,
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#0A001F"
    },
    "android": {
      "package": "com.certxa.owner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000010"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.NFC",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.USB_PERMISSION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withJitpack",
      "./plugins/withUsbPrinter",
      "./plugins/withKioskMode",
      "expo-secure-store",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "appDelegate": true,
          "tapToPayCheck": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Certxa needs location access to discover nearby Bluetooth card readers."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050C18",
          "image": "./assets/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "extraProguardRules": "-keep class com.stripeterminalreactnative.** { *; }\n-keep class com.stripe.** { *; }\n-keepclassmembers class * extends com.facebook.react.bridge.ReactContextBaseJavaModule { *; }\n-keepclassmembers class * implements com.facebook.react.bridge.NativeModule { *; }"
          }
        }
      ],
      "expo-navigation-bar",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {},
      "eas": {
        "projectId": "01e6b026-b16a-488d-a32e-0046018b5437"
      }
    },
    "owner": "tobybens-team",
    "updates": {
      "url": "https://u.expo.dev/01e6b026-b16a-488d-a32e-0046018b5437",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.certxa.owner",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Certxa needs location access to discover nearby Bluetooth card readers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Certxa needs location access to discover nearby Bluetooth card readers.",
        "NSBluetoothAlwaysUsageDescription": "Certxa uses Bluetooth to connect to card readers and receipt printers.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
