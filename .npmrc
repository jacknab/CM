auto-install-peers=false
strict-peer-dependencies=false
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=@babel/generator

# EAS cloud builds: suppress ERR_PNPM_IGNORED_BUILDS from pnpm 10.9+.
# Native build scripts (esbuild, sharp, etc.) are not needed on the cloud
# build server — Metro handles JS bundling and Gradle handles native compilation.
# Local node_modules already has all binaries in place; fresh installs on EAS
# use pre-compiled platform packages so no script output is needed.
ignore-scripts=true
