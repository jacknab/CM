# /etc/certxa.env — VPS production secrets
# Copy this file to /etc/certxa.env on the VPS and fill in real values.
# Loaded automatically by scripts/dev-start.sh and should be sourced before
# starting PM2:
#   set -a && source /etc/certxa.env && set +a && pm2 start ecosystem.config.cjs

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://certxausr_1:CHANGE_ME@localhost:5432/certxadata_1

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_64_hex_chars

# ── Redis (optional — disabling falls back to live DB queries) ────────────────
REDIS_URL=redis://default:CHANGE_ME@127.0.0.1:6379
REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_ME

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://certxa.com
CORS_ORIGINS=https://certxa.com,https://www.certxa.com
PHP_DIR=/apps/CM/php
TRIAL_PERIOD_DAYS=60

# Suppress AWS SDK v3 future Node requirement advisory on Node 20/21.
# This does NOT disable SDK functionality; it only silences the warning log.
AWS_SDK_JS_NODE_VERSION_SUPPORT_WARNING_DISABLED=true

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# ── Stripe (Connect + SaaS billing) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_CONNECT_CLIENT_ID=ca_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: accept multiple Stripe webhook secrets during rotation
# STRIPE_WEBHOOK_SECRETS=whsec_live...,whsec_test...

# ── Mailgun ───────────────────────────────────────────────────────────────────
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mg.certxa.com

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
