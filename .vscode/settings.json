{
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.local/**": true,
    "**/backups/**": true,
    "**/logs/**": true,
    "**/attached_assets/**": true,
    "**/snap/**": true,
    "**/templates-storage/**": true,
    "**/thumbnails-storage/**": true,
    "**/videos/**": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.local": true,
    "**/backups": true,
    "**/logs": true,
    "**/attached_assets": true,
    "**/snap": true,
    "**/templates-storage": true,
    "**/thumbnails-storage": true,
    "**/videos": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.local": true,
    "**/backups": true,
    "**/logs": true,
    "**/attached_assets": true,
    "**/snap": true,
    "**/templates-storage": true,
    "**/thumbnails-storage": true,
    "**/videos": true
  },
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.maxTsServerMemory": 1024,
  // Tailwind CSS v4 (`@import 'tailwindcss'`) introduces at-rules (@plugin,
  // @custom-variant, @theme, @apply) that VS Code's built-in CSS language
  // server doesn't recognize — it flags them as "Unknown at rule" even
  // though they're valid and required for the Tailwind v4 build.
  "css.lint.unknownAtRules": "ignore",
  // mysalon's index.css has deliberately empty `.no-default-hover-elevate` /
  // `.no-default-active-elevate` rulesets used only as `:not()` selector
  // targets elsewhere in the same file — not a mistake, but the built-in
  // linter can't tell the two apart, and there's no per-rule suppression
  // comment it supports. Turning this rule off does mean a genuinely
  // accidental empty ruleset elsewhere won't be flagged either.
  "css.lint.emptyRules": "ignore"
}